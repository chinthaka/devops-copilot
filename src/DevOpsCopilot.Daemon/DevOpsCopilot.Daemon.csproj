<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-DevOpsCopilot.Daemon-f6bcefe1-0b1e-448b-a7a0-18f3ac74fa34</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageReference Include="Azure.Messaging.EventHubs.Processor" Version="5.12.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.25.0" />
    <PackageReference Include="Microsoft.Azure.Kusto.Data" Version="14.2.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevOpsCopilot.Domain\DevOpsCopilot.Domain.csproj" />
    <ProjectReference Include="..\DevOpsCopilot.Application\DevOpsCopilot.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DevOpsCopilot.Domain" />
    <Using Include="DevOpsCopilot.Application" />
    <Using Include="DevOpsCopilot.Application.ILogQuery" Alias="IKustoQueryRunner" />
    <Using Include="DevOpsCopilot.Application.IKnowledgeSearch" Alias="IPostmortemSearch" />
  </ItemGroup>
</Project>
