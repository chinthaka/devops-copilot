<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>d04fe575-631e-4cbd-9e92-f3b231265a1e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server, the worker and the sample API are added by path (AddDotnetProject), so they
         need no reference here. The Functions sample still goes through AddAzureFunctionsProject,
         which needs the generated Projects.* type; without the old AppHost SDK that type is only
         generated when the reference is marked as an Aspire project resource. -->
    <ProjectReference Include="..\DevOpsCopilot.Functions\DevOpsCopilot.Functions.csproj"
                      IsAspireProjectResource="true"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Azure.EventHubs" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="17.0.0" />
	<PackageReference Include="Aspire.Hosting.Azure.Functions" Version="17.0.0" />
	<PackageReference Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
  </ItemGroup>
</Project>
