<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Azure OpenAI endpoint, deployment and key for the gated integration test. Never in the repo. -->
    <UserSecretsId>devopscopilot-infrastructure-tests-7c0a1f52-3d9e-4a61-9b8c-2f5d6e41a083</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker's appsettings.json is the one home of non-secret values (URLs, timeouts, retry
         caps); the gated integration tests layer user secrets over it. -->
    <None Include="..\..\src\DevOpsCopilot.Worker\appsettings.json" Link="worker.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevOpsCopilot.Infrastructure\DevOpsCopilot.Infrastructure.csproj" />
  </ItemGroup>

</Project>
